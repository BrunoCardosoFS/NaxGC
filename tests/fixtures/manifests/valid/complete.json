{
  "$schema": "../../../../schemas/manifest.schema.json",
  "schema": 1,
  "x-author-note": "custom extension field",
  "meta": {
    "id": "naxgc.test.complete",
    "name": "Complete Feature Test",
    "version": "1.0.0",
    "author": "NaxGC Tests",
    "description": "Validates all controls, easings, markers, triggers, states, and actions.",
    "requires": { "naxgc": ">=0.1.0" }
  },
  "canvas": { "width": 1920, "height": 1080, "fps": 60 },
  "svg": "layout.svg",
  "initialState": "offair",
  "layers": {
    "barra": {
      "type": "svg",
      "id": "barra",
      "origin": [0.5, 0.5],
      "opacity": 1.0,
      "visible": true,
      "fill": "#0b2a5b",
      "stroke": "#ffd23f",
      "strokeWidth": 2.0,
      "rasterScale": 1.5
    },
    "mask_barra": {
      "type": "svg",
      "id": "mask_barra",
      "role": "mask"
    },
    "titulo": {
      "type": "text",
      "id": "txt_titulo",
      "text": "DESTAQUE",
      "font": "Inter",
      "weight": 700,
      "italic": false,
      "size": 36,
      "minSize": 24,
      "color": "#ffffff",
      "align": "left",
      "valign": "middle",
      "overflow": "shrink",
      "maxLines": 1,
      "lineHeight": 1.2,
      "letterSpacing": 1.0,
      "uppercase": true,
      "mask": "mask_barra",
      "maskMode": "alpha"
    },
    "grupo_tag": {
      "type": "svg",
      "id": "grupo_tag"
    },
    "dot": {
      "type": "svg",
      "id": "dot"
    }
  },
  "states": {
    "offair": {
      "layers.barra.x": -1000,
      "layers.mask_barra.x": -1000,
      "layers.grupo_tag.opacity": 0
    },
    "tema_escuro": {
      "layers.barra.fill": "#112233",
      "layers.titulo.color": "#abcdefff"
    }
  },
  "panel": {
    "title": "Painel Completo",
    "sections": [
      {
        "title": "Geral",
        "collapsed": false,
        "columns": 2,
        "controls": [
          {
            "key": "titulo_txt",
            "label": "Título",
            "type": "text",
            "bind": "layers.titulo.text",
            "default": "DESTAQUE",
            "placeholder": "Digite o título",
            "maxLength": 40,
            "submitAction": "show"
          },
          {
            "key": "escala_barra",
            "label": "Escala",
            "type": "number",
            "bind": "layers.barra.scale",
            "default": 1.0,
            "min": 0.5,
            "max": 2.0,
            "step": 0.1,
            "slider": true,
            "unit": "x"
          },
          {
            "key": "mostrar_tag",
            "label": "Tag Visível",
            "type": "toggle",
            "bind": "layers.grupo_tag.visible",
            "default": true
          },
          {
            "key": "cor_barra",
            "label": "Cor",
            "type": "color",
            "bind": "layers.barra.fill",
            "default": "#0b2a5b"
          },
          {
            "key": "tema",
            "label": "Tema",
            "type": "dropdown",
            "default": "tema_escuro",
            "options": [
              { "label": "Escuro", "apply": "tema_escuro" }
            ]
          },
          { "type": "separator" },
          { "type": "label", "label": "Comandos" },
          { "type": "button", "label": "Entrar", "action": "show", "style": "primary", "hotkey": "NaxGC: Show" },
          { "type": "button", "label": "Reset", "action": "reset", "style": "danger" }
        ]
      }
    ]
  },
  "animations": {
    "in": {
      "markers": { "meio": 0.25 },
      "tracks": [
        { "layer": "barra", "prop": "x", "from": -1000, "to": 0, "dur": 0.5, "ease": [0.25, 0.1, 0.25, 1.0] }
      ],
      "triggers": [
        { "play": "mask.in", "on": "marker:meio", "mode": "linked", "speed": "inherit" },
        { "play": "tag.in", "on": "end", "delay": 0.05, "mode": "detached", "speed": 1.2 }
      ]
    },
    "mask.in": {
      "tracks": [
        { "layer": "mask_barra", "prop": "x", "from": -1000, "to": 0, "dur": 0.4, "ease": "outCubic" }
      ]
    },
    "tag.in": {
      "onEnd": "hold",
      "retrigger": "restart",
      "tracks": [
        { "layer": "grupo_tag", "prop": "opacity", "keys": [[0, 0], [0.2, 1]], "ease": "inOutSine" }
      ]
    },
    "pulse": {
      "loop": true,
      "duration": 1.0,
      "tracks": [
        { "layer": "dot", "prop": "opacity", "keys": [[0, 1], [0.5, 0.2], [1.0, 1]], "ease": "linear" }
      ]
    }
  },
  "actions": {
    "enter_core": [
      { "play": "in" },
      { "play": "pulse", "delay": 0.5 }
    ],
    "show": [
      { "call": "enter_core" }
    ],
    "reset": [
      { "stop": "pulse" },
      { "set": "offair" }
    ]
  }
}

